meta {
  name: 01 - Validar disponibilidad de reserva
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/reservas/validar
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "huespedId": {{usuarioId}},
    "capsulaId": "C-101",
    "fechaInicio": "2025-09-01",
    "fechaFinal": "2025-09-03"
  }
}

tests {
  test("Validación correcta devuelve 200", function() {
    expect(res.status).to.equal(200);
  });
}
